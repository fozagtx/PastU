SESSION_SECRET=
DELEGATE_KEY_SECRET=
NEBIUS_API_KEY=
# Neon Postgres. `neon deploy` writes these. DATABASE_URL is pooled (app traffic); DATABASE_URL_UNPOOLED is direct (migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon AI Gateway (fallback model provider when no Nebius key is set).
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
TATUM_API_KEY=
# Optional: one shared Walrus Memory agent for the whole app (private key + account ID from the Walrus Memory dashboard).
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Chain for the vault: testnet (default) or mainnet. Drives wallet, Sui client and Tatum URL.
NEXT_PUBLIC_SUI_NETWORK=testnet
